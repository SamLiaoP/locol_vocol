{
  "id": "com.speakr.app",
  "name": "Locol-Vocol",
  "short_name": "Locol-Vocol",
  "description": "把對話留下來：會議錄音、繁體中文逐字稿與人物辨識。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fcf8f3",
  "theme_color": "#fcf8f3",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "lang": "zh-Hant",
  "dir": "ltr",
  "icons": [
    {
      "src": "/static/img/locol-favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Recording",
      "short_name": "New",
      "description": "Upload or record new audio",
      "url": "/#upload",
      "icons": [
        {
          "src": "/static/img/locol-favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "View Gallery",
      "short_name": "Gallery",
      "description": "Access your recordings gallery",
      "url": "/#gallery",
      "icons": [
        {
          "src": "/static/img/locol-favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_audio",
          "accept": [
            "audio/*",
            "video/mp4",
            "video/quicktime",
            "video/x-matroska",
            "video/webm"
          ]
        }
      ]
    }
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/*": [
          ".mp3",
          ".wav",
          ".m4a",
          ".ogg",
          ".webm",
          ".flac",
          ".aac",
          ".wma",
          ".opus"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+speakr",
      "url": "/?audio=%s"
    }
  ]
}
