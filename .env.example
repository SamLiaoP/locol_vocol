# ===================== 轉錄 (STT)：ElevenLabs Scribe v2 =====================
TRANSCRIPTION_CONNECTOR=elevenlabs
TRANSCRIPTION_API_KEY=your_elevenlabs_api_key
TRANSCRIPTION_MODEL=scribe_v2

# --- 其他引擎（也可以在 管理 → 系統設定 裡分別填 key，之後用頁首的下拉切換） ---
# TRANSCRIPTION_API_KEY=sk-...            # OpenAI
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# TRANSCRIPTION_CONNECTOR=assemblyai      # AssemblyAI
# ASSEMBLYAI_SPEECH_MODEL=universal-3-pro,universal-2

# ===================== 文字模型（摘要）：已停用 =====================
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_NAME=openai/gpt-4o-mini

# ===================== 管理員帳號（第一次啟動時自動建立） =====================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

ALLOW_REGISTRATION=false
REGISTRATION_ALLOWED_DOMAINS=
SUMMARY_MAX_TOKENS=8000
